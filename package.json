{
  "name": "voicechanger",
  "productName": "VoiceChanger",
  "version": "1.0.1",
  "description": "Real-time voice changer for Windows",
  "author": "W1CKIX",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.w1ckix.voicechanger",
    "productName": "VoiceChanger",
    "copyright": "VoiceChanger by W1CKIX",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VoiceChanger",
      "artifactName": "VoiceChanger-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "VoiceChanger-Portable-${version}.exe"
    }
  }
}
